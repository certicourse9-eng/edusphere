# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and is only read by server-side route handlers
# (app/api/*/route.ts) - it is never bundled into client-side code, so the
# browser never sees any of these values.

# Get your key from https://console.groq.com/keys - free tier, no card needed.
GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-120b if unset.
GROQ_MODEL=openai/gpt-oss-120b

# Multi-account / multi-provider failover (all optional): grading tries every configured
# account below in order and automatically falls through to the next one on a rate limit,
# quota error, auth failure, or outage. Add more Groq accounts (e.g. a second free-tier
# account) as GROQ_API_KEY_2, GROQ_API_KEY_3, ... and/or an OpenAI account as OPENAI_API_KEY,
# OPENAI_API_KEY_2, ... - Groq accounts are always tried before OpenAI ones. See the
# "AI provider status" panel in the app for live health/usage per account.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# OPENAI_API_KEY=
# OPENAI_API_KEY_2=
# Optional: defaults to gpt-4o-mini if unset.
# OPENAI_MODEL=gpt-4o-mini

# Access token for the hosted PaddleOCR job API at
# https://paddleocr.aistudio-app.com/api/v2/ocr/jobs. Get it from
# aistudio.baidu.com/paddleocr -> your OCR service -> "API调用示例" panel.
PADDLEOCR_ACCESS_TOKEN=
